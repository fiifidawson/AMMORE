# set PROVIDER to "mistral" or "ollama"
PROVIDER=mistral

# Mistral API (https://console.mistral.ai)
MISTRAL_API_KEY=your-key-here
MISTRAL_MODEL=mistral-small-latest

# Ollama (local, run `ollama serve` first)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# mmore retriever - needs to be running on port 8001
MMORE_RETRIEVER_URL=http://127.0.0.1:8001/v1/retrieve
