# API key for Mistral (https://console.mistral.ai)
# Everything else (provider, models, URLs, etc.) lives in config.yaml
MISTRAL_API_KEY=your-key-here

# Optional: Tavily key for web search (https://tavily.com — free tier for students)
# Required only if websearch.enabled=true in config.yaml
TAVILY_API_KEY=your-tavily-key-here
